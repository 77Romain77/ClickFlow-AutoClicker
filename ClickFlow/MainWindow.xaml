<Window x:Class="ClickFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickFlow - AutoClicker" Width="1020" Height="780"
        MinWidth="860" MinHeight="690" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="51" Height="51" CornerRadius="14" Background="#243D78" Margin="0,0,13,0">
                    <TextBlock Text="↗" FontSize="28" FontWeight="Bold" Foreground="#9DC0FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ClickFlow" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="AUTOCLICKER" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="22"
                    Padding="15,9" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8DA1BF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusBadge" Text="INACTIF" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.72*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="17" Padding="22" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Vitesse de clic" Style="{StaticResource Heading}"/>
                            <TextBlock Text="Choisis une cadence fixe ou des variations de CPS." Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                            <TextBlock Text="Mode de variation" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CpsModeBox" SelectionChanged="Configuration_Changed">
                                <ComboBoxItem Content="Fixed - constant"/>
                                <ComboBoxItem Content="Random - aléatoire"/>
                                <ComboBoxItem Content="Natural - progressif"/>
                            </ComboBox>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="13">
                                    <StackPanel>
                                        <TextBlock x:Name="MinimumLabel" Text="Minimum CPS" Style="{StaticResource Hint}"/>
                                        <TextBox x:Name="MinCpsText" Width="78" HorizontalAlignment="Left" FontSize="21"
                                                 FontWeight="SemiBold" Margin="0,7,0,1" TextChanged="MinCpsText_Changed"
                                                 LostFocus="CpsText_LostFocus"/>
                                        <Slider x:Name="MinCpsSlider" Minimum="1" Maximum="100" TickFrequency="0.5"
                                                IsSnapToTickEnabled="False" ValueChanged="MinCpsSlider_Changed"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="Maximum CPS" Style="{StaticResource Hint}"/>
                                        <TextBox x:Name="MaxCpsText" Width="78" HorizontalAlignment="Left" FontSize="21"
                                                 FontWeight="SemiBold" Margin="0,7,0,1" TextChanged="MaxCpsText_Changed"
                                                 LostFocus="CpsText_LostFocus"/>
                                        <Slider x:Name="MaxCpsSlider" Minimum="1" Maximum="100" TickFrequency="0.5"
                                                IsSnapToTickEnabled="False" ValueChanged="MaxCpsSlider_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="VariationLabel" Text="Intensité des variations (Natural)" Style="{StaticResource Hint}" Margin="0,14,0,6"/>
                            <ComboBox x:Name="VariationBox" SelectionChanged="Configuration_Changed">
                                <ComboBoxItem Content="Low - faible"/>
                                <ComboBoxItem Content="Medium - moyenne"/>
                                <ComboBoxItem Content="High - élevée"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="17" Padding="22" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Activation" Style="{StaticResource Heading}"/>
                            <TextBlock Text="Utilise un raccourci clavier ou un bouton de souris." Style="{StaticResource Hint}" Margin="0,4,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Comportement" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ActivationBox" SelectionChanged="Configuration_Changed">
                                        <ComboBoxItem Content="Hold - maintenir"/>
                                        <ComboBoxItem Content="Toggle - basculer"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Déclenchement" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TriggerBox" SelectionChanged="Configuration_Changed">
                                        <ComboBoxItem Content="Direct"/>
                                        <ComboBoxItem Content="Avec souris maintenue"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Touche d'activation" Style="{StaticResource Hint}" Margin="0,17,0,6"/>
                            <Button x:Name="ActivationKeyButton" Content="Définir la touche" Click="ActivationKeyButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <StackPanel x:Name="GatePanel" Margin="0,14,0,0">
                                <TextBlock Text="Bouton physique à maintenir" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="GateMouseBox" SelectionChanged="Configuration_Changed">
                                    <ComboBoxItem Content="Clic gauche"/>
                                    <ComboBoxItem Content="Clic droit"/>
                                    <ComboBoxItem Content="Clic central"/>
                                    <ComboBoxItem Content="Mouse 4"/>
                                    <ComboBoxItem Content="Mouse 5"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Clic à générer" Style="{StaticResource Hint}" Margin="0,15,0,6"/>
                            <ComboBox x:Name="ClickButtonBox" SelectionChanged="Configuration_Changed">
                                <ComboBoxItem Content="Clic gauche"/>
                                <ComboBoxItem Content="Clic droit"/>
                                <ComboBoxItem Content="Clic central"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,0,2">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="17" Padding="18" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Profils" Style="{StaticResource Heading}"/>
                            <TextBlock Text="Configurations enregistrées" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                            <ComboBox x:Name="ProfilesBox" DisplayMemberPath="Name"
                                      SelectionChanged="ProfilesBox_SelectionChanged"/>
                            <TextBox x:Name="ProfileNameText" Margin="0,10,0,9" ToolTip="Renommer le profil"
                                     TextChanged="ProfileName_Changed" LostFocus="ProfileName_LostFocus"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ Nouveau" Click="NewProfile_Click"/>
                                <Button Grid.Column="2" Content="Dupliquer" Click="DuplicateProfile_Click"/>
                            </Grid>
                            <Button Content="Supprimer ce profil" Click="DeleteProfile_Click" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="17" Padding="18" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Sécurité" Style="{StaticResource Heading}"/>
                            <CheckBox x:Name="FocusLossCheck" Content="Arrêter au changement de fenêtre"
                                      Margin="0,13,0,11" Checked="FocusLoss_Changed" Unchecked="FocusLoss_Changed"/>
                            <TextBlock Text="Arrêt d'urgence global" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <Button x:Name="EmergencyButton" Content="F12" Click="EmergencyButton_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="17" Padding="18" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Statistiques" Style="{StaticResource Heading}"/>
                            <TextBlock Text="CPS réels (dernière seconde)" Style="{StaticResource Hint}" Margin="0,12,0,2"/>
                            <TextBlock x:Name="RealCpsText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Clics générés depuis le lancement" Style="{StaticResource Hint}" Margin="0,9,0,2"/>
                            <TextBlock x:Name="TotalClicksText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="17" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Mises à jour" Style="{StaticResource Heading}"/>
                            <CheckBox x:Name="AutoUpdateCheck" Content="Télécharger automatiquement" Margin="0,12,0,11"
                                      Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
                            <Button Content="Vérifier les mises à jour" Click="CheckUpdates_Click"/>
                            <TextBlock x:Name="UpdateStatusText" Text="Version 0.1.0" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="14,12" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterStatusText" Text="Prêt. Active les clics depuis l'application cible." FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Les raccourcis restent actifs quand ClickFlow est réduit." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Arrêt immédiat" Click="Stop_Click" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
